# ELF64/AArch64 -> checked relocatable QAR2. Translated from QOS's MIT - licensed
# mkqa/mkexports algorithms. No Python, Make, objcopy or readelf is invoked.
unsafe module.
C = use "common".
at b i = C.need (Bytes.at i b).
part b off n = C.need (Bytes.slice off n b).
uint b off n = List.fold (fn acc i -> acc * 256 + at b (off + n - i - 1)) 0 (List.range 0 (n - 1)).
u16 b i = uint b i 2.
u32 b i = uint b i 4.
u64 b i = uint b i 8.
encode32 n = C.need (Bytes.fromList (List.map (fn factor -> Num.floor (n / factor) % 256) [1,256,65536,16777216])).
text s = C.need (Utf8.encode s).
zeros n = C.need (Bytes.fromList (List.map (fn i -> 0) (List.range 1 n))).
hash b = Hex.encode (Sha256.bytes b).

# Small stable merge sort; comparators use integer/address or ASCII ordering.
halve [] = ([],[]).
halve [x] = ([x],[]).
halve (a :: b :: rest) = (xs,ys) = halve rest; (a :: xs,b :: ys).
merge lt [] ys = ys.
merge lt xs [] = xs.
merge lt (x :: xs) (y :: ys) = if lt y x then y :: merge lt (x :: xs) ys else x :: merge lt xs (y :: ys).
sort lt [] = [].
sort lt [x] = [x].
sort lt xs = (left,right) = halve xs; merge lt (sort lt left) (sort lt right).
lessText a b i | i >= Str.len a = i < Str.len b.
lessText a b i | i >= Str.len b = False.
lessText a b i = if Str.at a i == Str.at b i then lessText a b (i + 1) else Str.at a i < Str.at b i.
unique [] = [].
unique [x] = [x].
unique (x :: y :: rest) = if x == y then unique (y :: rest) else x :: unique (y :: rest).

validate b =
  _ = C.check "expected ELF64 little - endian AArch64" (Bytes.len b >= 64 and
    Bytes.toList (part b 0 6) == [127,69,76,70,2,1] and u16 b 18 == 183);
  Unit.
sections b =
  off = u64 b 40; width = u16 b 58; count = u16 b 60;
  _ = C.check "invalid ELF section table" (width >= 64 and count > 0 and count < 65535 and off + width * count <= Bytes.len b);
  List.map (fn i -> p = off + i * width;
    {typ=u32 b (p+4),flags=u64 b (p+8),addr=u64 b (p+16),off=u64 b (p+24),
     size=u64 b (p+32),link=u32 b (p+40),info=u32 b (p+44),entsz=u64 b (p+56)}) (List.range 0 (count - 1)).
segments b =
  off = u64 b 32; width = u16 b 54; count = u16 b 56;
  _ = C.check "invalid ELF program table" (width >= 56 and count > 0 and off + width * count <= Bytes.len b);
  sort (fn a b -> a.addr < b.addr) (List.filter (fn s -> s.typ == 1 and s.mem > 0)
    (List.map (fn i -> p = off + i * width;
      {typ=u32 b p,flags=u32 b (p+4),off=u64 b (p+8),addr=u64 b (p+16),
       size=u64 b (p+32),mem=u64 b (p+40)}) (List.range 0 (count - 1)))).
cstring b off limit acc =
  _ = C.check "invalid ELF symbol string" (off < limit and Str.len acc <= 1024);
  c = at b off;
  if c == 0 then acc else cstring b (off + 1) limit "{acc}{Str.fromCode c}".
symbols b secs =
  List.concat (List.map (fn sec -> strings = secs ! sec.link;
    _ = C.check "invalid ELF symbol table" (sec.entsz >= 24 and sec.size % sec.entsz == 0);
    List.map (fn i -> p = sec.off + i * sec.entsz;
      {name=cstring b (strings.off + u32 b p) (strings.off + strings.size) "",
       bind=Num.floor (at b (p+4) / 16),index=u16 b (p+6),value=u64 b (p+8),size=u64 b (p+16)})
      (List.range 0 (Num.floor (sec.size / sec.entsz) - 1)))
    (List.filter (fn sec -> sec.typ == 2) secs)).
exported s = s.bind == 1 and s.index != 0 and s.index != 65521 and
  Str.startsWith "fpr_" s.name and not (Str.startsWith "fpr_fn_" s.name) and
  not (Str.startsWith "fpr_obj_" s.name) and s.name != "fpr_modtab" and s.name != "fpr_contab".
safeName s = Str.len s > 0 and List.all (fn c -> (c >= 65 and c <= 90) or
  (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or List.has c [95,46,36]) (Str.codes s).
exports input output =
  b = C.readBytes input; _ = validate b;
  rows = sort (fn a b -> lessText a.name b.name 0) (List.filter exported (symbols b (sections b)));
  _ = C.check "invalid exported symbol name" (List.all (fn s -> safeName s.name) rows);
  indexed = List.zip (List.range 0 (List.len rows - 1)) rows;
  table = List.map (fn item -> (i,s)=item; "  .quad .Lqx{i}\n  .quad {s.name}\n  .quad {s.size}") indexed;
  names = List.map (fn item -> (i,s)=item; ".Lqx{i}:\n  .asciz \"{s.name}\"") indexed;
  C.writeText output "# generated by Sol\n.section .rodata.qos_exports,\"a\",@progbits\n.balign 8\n.globl qos_exports\nqos_exports:\n  .quad {List.len rows}\n{Str.join "\n" table}\n{Str.join "\n" names}\n".

flatten b =
  _ = validate b;
  loads = segments b;
  _ = C.check "ELF must link at zero or a valid moved base" (loads != []);
  first = loads ! 0; base = first.addr;
  end = List.fold (fn n s -> Numeric.max n (s.addr + s.size)) base (List.filter (fn s -> s.size > 0) loads);
  memend = List.fold (fn n s -> Numeric.max n (s.addr + s.mem)) base loads;
  execend = List.fold (fn n s -> if s.flags % 2 == 1 then Numeric.max n (s.addr + s.size) else n) base loads;
  rwoff = List.fold (fn n s -> if s.flags % 4 >= 2 then Numeric.min n (s.addr - base) else n) (memend - base) loads;
  (_,chunks) = List.fold (fn state s -> (cursor,chunks)=state;
    if s.size == 0 then state else
      _ = C.check "overlapping/oversized ELF load segments" (s.addr >= cursor and end - base <= 16777216);
      (s.addr+s.size,part b s.off s.size :: zeros (s.addr - cursor) :: chunks)) (base,[]) loads;
  image = Bytes.concat (List.rev chunks);
  entry = u64 b 24 - base;
  _ = C.check "ELF entry outside image" (entry >= 0 and entry < memend - base);
  {base=base,entry=entry,execsz=execend - base,rwoff=rwoff,image=image,memsz=memend - base}.

relocations b secs imageSize =
  groups = List.filter (fn sec -> if sec.typ != 4 then False else
    target = secs ! sec.info; target.flags % 4 >= 2) secs;
  offsets = List.concat (List.map (fn sec ->
    _ = C.check "invalid ELF relocation table" (sec.entsz >= 24 and sec.size % sec.entsz == 0);
    symtab = secs ! sec.link;
    List.concat (List.map (fn i -> p = sec.off + i*sec.entsz;
      offset=u64 b p; info=u64 b (p+8); typ=info % 4294967296; symbol=Num.floor (info / 4294967296);
      index=u16 b (symtab.off + symbol*symtab.entsz + 6);
      if List.has typ [0,260,261,262,273,274,275,276,277,278,284,285,286,299,279,280,282,283] or index == 65521 then []
      else if typ == 257 and index != 0 then
        _ = C.check "relocation word outside image" (offset >= 0 and offset + 8 <= imageSize); [offset]
      else error "unsupported image relocation {typ} at {offset}")
      (List.range 0 (Num.floor (sec.size/sec.entsz) - 1)))) groups);
  unique (sort (fn a b -> a < b) offsets).

checkMoved image moved offsets cursor = case offsets of
    [] -> C.check "nonrelocatable image suffix" (part image cursor (Bytes.len image - cursor) == part moved cursor (Bytes.len moved - cursor))
  | offset :: rest ->
      _ = C.check "nonrelocatable image prefix at {offset}" (part image cursor (offset - cursor) == part moved cursor (offset - cursor));
      _ = C.check "wrong relocation at {offset}" (u64 moved offset == u64 image offset + 268435456);
      checkMoved image moved rest (offset+8).
archive name abi input shifted output =
  b = C.readBytes input; image = flatten b;
  moved = flatten (C.readBytes shifted);
  _ = C.check "inconsistent moved image layout" (image.base == 0 and moved.base == 268435456 and
    image.entry == moved.entry and image.execsz == moved.execsz and image.rwoff == moved.rwoff and
    image.memsz == moved.memsz and Bytes.len image.image == Bytes.len moved.image);
  relocs = relocations b (sections b) (Bytes.len image.image);
  _ = checkMoved image.image moved.image relocs 0;
  relocBytes = Bytes.concat (List.map encode32 relocs);
  manifest = text "architecture = \"aarch64\"\nname = \"{name}\"\nid = \"{name}\"\nversion = \"0.1.0\"\nentry = \"n/a\"\nloadMode = \"process\"\nabi = \"{abi}\"\n";
  load = text "base 0\nentry {image.entry}\nexecsz {image.execsz}\nrwoff {image.rwoff}\nimagesz {Bytes.len image.image}\nmemsz {image.memsz}\nsha {hash image.image}\nrelsha {hash relocBytes}\n";
  blobs = [("MANIFEST",manifest),("LOAD",load),("IMAGE",image.image),("RELOC",relocBytes)];
  (_,table) = List.fold (fn state item -> (off,lines)=state; (name,bytes)=item;
    (off+Bytes.len bytes,lines+["{name} {off} {Bytes.len bytes}"])) (0,[]) blobs;
  header = text "QAR2\n{Str.join "\n" table}\n\n";
  _ = C.writeBytes output (Bytes.concat (header :: List.map (fn item -> (name,b)=item; b) blobs));
  print "Packed {output}: {Bytes.len image.image} image bytes, {List.len relocs} checked relocations".
